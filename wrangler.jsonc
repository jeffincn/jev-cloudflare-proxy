{
  "name": "jev-cloudflare-proxy",
  "account_id": "5b6c981ebeb77b3e3566ffc9ba8be751",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  // Placement alone does not fix LHR-ingress AI Gateway failures; kept for latency.
  "placement": {
    "region": "aws:ap-southeast-1"
  },
  "routes": [
    { "pattern": "jev-proxy.topviewai.app", "custom_domain": true }
  ],
  "ai": { "binding": "AI" },
  // Escape hatch: run inference in APAC when LHR-edge Worker REST/binding fails.
  "durable_objects": {
    "bindings": [
      { "name": "JEV", "class_name": "JevInference" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["JevInference"] }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
