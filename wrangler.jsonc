{
  "name": "jev-cloudflare-proxy",
  "account_id": "5b6c981ebeb77b3e3566ffc9ba8be751",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  // Placement alone does not fix LHR-ingress AiGatewayError 2002 (remote-SIN still fails).
  // Keep it for latency; recovery is WORKERS_DEV_ORIGIN hop and/or CF_AI_API_TOKEN REST.
  "placement": {
    "region": "aws:ap-southeast-1"
  },
  "vars": {
    "WORKERS_DEV_ORIGIN": "https://jev-cloudflare-proxy.imabing.workers.dev"
  },
  "routes": [
    { "pattern": "jev-proxy.topviewai.app", "custom_domain": true }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
