{
  "name": "jev-cloudflare-proxy",
  "account_id": "5b6c981ebeb77b3e3566ffc9ba8be751",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  // Placement does not cure LHR-ingress AI Gateway 2002; kept for latency only.
  "placement": {
    "region": "aws:ap-southeast-1"
  },
  // Self service binding: internal re-entry without public URL (workers.dev hop returned 522).
  "services": [
    { "binding": "SELF", "service": "jev-cloudflare-proxy" }
  ],
  "routes": [
    { "pattern": "jev-proxy.topviewai.app", "custom_domain": true }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
