{
  "name": "jev-cloudflare-proxy",
  "account_id": "5b6c981ebeb77b3e3566ffc9ba8be751",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "placement": {
    "region": "aws:ap-southeast-1"
  },
  "routes": [
    { "pattern": "jev-proxy.topviewai.app", "custom_domain": true }
  ],
  "ai": { "binding": "AI" },
  // v1 created JevInference during earlier LHR experiments; v2 removes it.
  // LHR recovery is now an off-platform relay (RELAY_URL / RELAY_KEY secrets).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["JevInference"] },
    { "tag": "v2", "deleted_classes": ["JevInference"] }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
